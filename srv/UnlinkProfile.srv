# Remove one wrongly-linked face or voice profile from a person (e.g. VSAD
# matched the wrong speaker, or face recognition merged the wrong track).
# The person itself is kept, only that one profile link is dropped.
string person_id
string kind          # "face" or "voice"
string profile_id    # e.g. "U7" or "speaker14"
string source         # optional: empty = default source for kind
                       # (face_recognition / speaker_recognition)
---
bool success
string message
