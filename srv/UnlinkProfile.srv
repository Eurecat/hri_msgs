# Remove one wrongly-linked face, voice, body or wearable profile from a person
# (e.g. VSAD matched the wrong speaker, or face recognition merged the wrong
# track). The person itself is kept, only that one profile link is dropped.
string person_id
string kind          # "face", "voice", "body" or "wearable"
string profile_id    # e.g. "U7", "speaker14", "Object_17" or "shimmer3_1FE7"
string source         # optional: empty = default source for kind
                       # (face_recognition / speaker_recognition / tips_body / wearable)
---
bool success
string message
